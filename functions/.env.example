# 非機密の設定値。`.env.<firebaseプロジェクトID>` という名前でコピーして使用してください。
# 例: disaster-taco プロジェクトなら `.env.disaster-taco`
SITE_URL=https://your-project.web.app
ORG_NAME=○○市 災害位置情報報告システム

# GMAIL_USER と GMAIL_APP_PASSWORD は機密情報のため .env には書かず、
# 以下のコマンドでシークレットとして登録してください。
#   firebase functions:secrets:set GMAIL_USER
#   firebase functions:secrets:set GMAIL_APP_PASSWORD
